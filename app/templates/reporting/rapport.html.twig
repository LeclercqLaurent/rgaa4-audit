<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>Rapport d'audit RGAA 4 — {{ rapport.projetNom }}</title>
    <style>
        body { font-family: "DejaVu Sans", sans-serif; color: #1a1a1a; font-size: 12px; line-height: 1.5; }
        h1 { font-size: 22px; border-bottom: 3px solid #000091; padding-bottom: 6px; }
        h2 { font-size: 16px; color: #000091; margin-top: 24px; }
        table { width: 100%; border-collapse: collapse; margin: 8px 0 16px; }
        caption { text-align: left; font-weight: bold; margin-bottom: 4px; }
        th, td { border: 1px solid #999; padding: 5px 7px; text-align: left; vertical-align: top; }
        th { background: #f0f0f5; }
        .taux { font-size: 28px; font-weight: bold; color: #000091; }
        .meta td:first-child { font-weight: bold; width: 30%; }
        .s-conforme { color: #18753c; font-weight: bold; }
        .s-non_conforme { color: #ce0500; font-weight: bold; }
        .s-non_applicable, .s-non_teste { color: #666; }
        .preuve { font-size: 11px; color: #444; margin-bottom: 5px; }
        .intitule { font-weight: normal; color: #444; }
        .reste { font-size: 11px; font-style: italic; color: #666; margin: 4px 0 0; }

        /* Les sélecteurs CSS relevés par axe-core sont longs et sans espace :
           sans césure forcée, Dompdf les laisse déborder hors de la page. Une
           largeur de colonne fixe empêche en plus la colonne des preuves de
           manger tout le tableau. */
        .plan { table-layout: fixed; }
        .c-critere { width: 26%; }
        .c-unite { width: 26%; }
        .c-preuves { width: 48%; }
        .plan code, .unite { font-family: monospace; font-size: 10px; color: #444; }
        .plan td, .plan code, .unite { word-wrap: break-word; word-break: break-all; }
    </style>
</head>
<body>
    {# Nombre d'occurrences montrees par critere dans le plan d'action. #}
    {% set max_preuves = 5 %}
    {% set libelles = {'conforme': 'Conforme', 'non_conforme': 'Non conforme', 'non_applicable': 'Non applicable', 'non_teste': 'Non testé'} %}
    {% set global = rapport.taux.global %}
    {% set complexite = rapport.type == 'complexite_php' %}
    {% set sujet = complexite ? 'le code' : 'le site' %}

    <h1>{% if complexite %}Rapport d'audit de complexité PHP{% else %}Rapport d'audit d'accessibilité RGAA 4{% endif %}</h1>

    <table class="meta">
        <caption>Informations sur l'audit</caption>
        <tbody>
            <tr><td>Projet</td><td>{{ rapport.projetNom }}</td></tr>
            <tr><td>Client</td><td>{{ rapport.client }}</td></tr>
            <tr><td>{{ complexite ? 'Chemin du code' : 'URL de référence' }}</td><td>{{ rapport.cible }}</td></tr>
            <tr><td>Date de génération</td><td>{{ rapport.dateGeneration }}</td></tr>
        </tbody>
    </table>

    <h2>{% if complexite %}Synthèse{% else %}Déclaration d'accessibilité{% endif %}</h2>
    <p>
        Au regard des critères automatiquement évalués, {{ sujet }} est
        {% if global is null %}<strong>non évalué</strong> (aucun critère évaluable automatiquement)
        {% elseif global >= 1 %}<strong>totalement conforme</strong>
        {% elseif global > 0 %}<strong>partiellement conforme</strong>
        {% else %}<strong>non conforme</strong>{% endif %}
        {% if complexite %}aux seuils de complexité.{% else %}au RGAA 4.{% endif %}
    </p>
    <p class="taux">Taux de conformité : {% if global is null %}Non évalué{% else %}{{ (global * 100)|round(1) }} %{% endif %}</p>
    <p>
        {{ rapport.taux.conformes }} critère(s) conforme(s), {{ rapport.taux.nonConformes }} non conforme(s),
        {{ rapport.taux.nonApplicables }} non applicable(s), {{ rapport.taux.nonTestes }} non testé(s).
    </p>

    {% if rapport.sections is not empty %}
    <table>
        <caption>Taux de conformité par {{ complexite ? 'lentille' : 'thématique' }}</caption>
        <thead><tr><th scope="col">{{ complexite ? 'Lentille' : 'Thématique' }}</th><th scope="col">Taux</th></tr></thead>
        <tbody>
            {% for section in rapport.sections %}
            <tr><td>{{ section.nom }}</td><td>{% if section.taux is null %}—{% else %}{{ (section.taux * 100)|round(1) }} %{% endif %}</td></tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}

    <h2>Détail des constats</h2>
    {% for section in rapport.sections %}
    <h3>{{ section.numero }}. {{ section.nom }}{% if section.taux is not null %} — {{ (section.taux * 100)|round(1) }} %{% endif %}</h3>
    <table>
        <caption>Constats de la section {{ section.nom }}</caption>
        <thead>
            <tr><th scope="col">Critère</th><th scope="col">Intitulé</th><th scope="col">Statut</th><th scope="col">Source</th></tr>
        </thead>
        <tbody>
            {% for ligne in section.lignes %}
            <tr>
                <td>{{ ligne.critereNumero }}</td>
                <td>{{ ligne.intitule|sans_glossaire }}</td>
                <td class="s-{{ ligne.statut.value }}">{{ libelles[ligne.statut.value] }}</td>
                <td>{{ ligne.source.value }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
    <p>Aucun constat enregistré pour ce projet.</p>
    {% endfor %}

    <h2>Plan d'action</h2>
    {% set plan = rapport.planAction %}
    {% if plan is empty %}
    <p>Aucune non-conformité automatique relevée.</p>
    {% else %}
    <table class="plan">
        <caption>Non-conformités à corriger</caption>
        <colgroup><col class="c-critere"><col class="c-unite"><col class="c-preuves"></colgroup>
        <thead>
            <tr><th scope="col">Critère</th><th scope="col">Unité auditée</th><th scope="col">Preuves</th></tr>
        </thead>
        <tbody>
            {% for ligne in plan %}
            <tr>
                <td><strong>{{ ligne.critereNumero }}</strong><br><span class="intitule">{{ ligne.intitule|sans_glossaire }}</span></td>
                <td class="unite">{{ ligne.uniteAuditee }}</td>
                <td>
                    {# Une même règle axe peut relever des dizaines d'occurrences sur
                       une page. Les lister toutes rend le plan d'action inutilisable :
                       on montre de quoi identifier le problème, et on annonce le reste. #}
                    {% for preuve in ligne.preuves|slice(0, max_preuves) %}
                    <div class="preuve"><strong>{{ preuve.regle }}</strong>{% if preuve.cible %}<br><code>{{ preuve.cible }}</code>{% endif %}</div>
                    {% endfor %}
                    {% set restantes = ligne.preuves|length - max_preuves %}
                    {% if restantes > 0 %}
                    <p class="reste">et {{ restantes }} autre{{ restantes > 1 ? 's' : '' }} occurrence{{ restantes > 1 ? 's' : '' }} de la même règle.</p>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% endif %}
</body>
</html>
